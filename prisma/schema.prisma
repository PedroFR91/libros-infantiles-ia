// Schema Prisma - Libros Infantiles IA

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(USER)
  sessionId     String?   @unique // Para usuarios anónimos (legacy)
  credits       Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  books         Book[]
  payments      Payment[]
  creditLedger  CreditLedger[]
  printOrders   PrintOrder[]
}

enum UserRole {
  USER
  ADMIN
}

model Book {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  
  title         String?
  kidName       String
  theme         String
  style         String    @default("cartoon")
  status        BookStatus @default(DRAFT)
  characterDescription String? // Descripción física del personaje basada en foto
  characterImageUrl    String? // URL of character reference illustration for consistency

  // Motor de historias v2
  ageRange      String?   // "3-4" | "5-6" | "7-8"
  companion     String?   // Compañero opcional pedido por el usuario (mascota, amigo...)
  bible         Json?     // Biblia del libro: personajes, escenarios, arco, valor
  dedication    String?   // Dedicatoria escrita por quien regala

  // Portada gratis con marca de agua; la limpia solo se expone tras pagar
  coverPreviewUrl String?
  coverImageUrl   String?
  unlockedAt      DateTime? // Ilustraciones pagadas

  // Emails
  leadEmail        String?   // Email dejado para recibir el borrador
  reminderSentAt   DateTime?
  readyEmailSentAt DateTime?

  showcase      Boolean   @default(false) // Ejemplo público en la landing

  // Enlace privado del libro (/libro/{id}?t=token): abre el libro sin cuenta
  accessToken   String?   @unique
  gender        String?   // "nino" | "nina" | null (concordancia del texto)
  freeRedraws   Int       @default(3) // dibujos que se pueden rehacer gratis (garantía)

  // Emails de la secuencia de venta
  leadPreviewSentAt   DateTime? // portada de muestra enviada al dejar el email
  printOfferSentAt    DateTime? // oferta del impreso tras comprar el digital
  reviewRequestSentAt DateTime? // petición de opinión
  
  // Cached PDF URLs
  digitalPdfUrl   String?
  printPdfUrl     String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pages         BookPage[]
  printOrders   PrintOrder[]

  @@index([userId])
  @@index([status])
}

model BookPage {
  id            String    @id @default(cuid())
  bookId        String
  book          Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  
  pageNumber    Int
  text          String?
  imagePrompt   String?
  imageUrl      String?
  thumbnailUrl  String?
  
  // Personalización de texto
  textPosition    String?   // bottom, top, center, bottom-left, etc.
  textBackground  String?   // none, gradient, bubble, box, banner
  textStyle       String?   // default, handwritten, comic, elegant, playful, bold
  textColor       String?   // hex color
  
  // Para refinado
  promptOverride String?

  // Escena del motor v2: { characters: string[], location: string, shot: string, action: string }
  scene          Json?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([bookId, pageNumber])
  @@index([bookId])
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  stripeSessionId String    @unique
  stripePaymentId String?
  customerEmail   String?   // Email introducido en Stripe Checkout
  amount          Int       // En centimos
  currency        String    @default("eur")
  status          PaymentStatus @default(PENDING)
  creditsGranted  Int       @default(0)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([stripeSessionId])
}

model CreditLedger {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  amount      Int       // Positivo = añadir, Negativo = consumir
  reason      String    // "purchase", "book_generation", "page_regeneration"
  referenceId String?   // bookId o paymentId
  balance     Int       // Balance después de esta transacción
  
  createdAt   DateTime  @default(now())

  @@index([userId])
}

enum BookStatus {
  DRAFT
  GENERATING
  COMPLETED
  ERROR
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Pedido de libro impreso (fase A: producción manual en la imprenta)
model PrintOrder {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId          String
  book            Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)

  stripeSessionId String           @unique
  stripePaymentId String?
  amount          Int              // Céntimos, IVA y envío incluidos
  currency        String           @default("eur")
  status          PrintOrderStatus @default(PENDING_PAYMENT)

  email           String?
  shippingName    String?
  shippingPhone   String?
  shippingAddress Json?            // { line1, line2, city, postal_code, state, country }

  kind            String           @default("upgrade") // "bundle" (impreso + PDF) | "upgrade" (ya tenía el PDF)
  quantity        Int              @default(1)         // copias del mismo libro al mismo envío
  approvedAt      DateTime?        // el cliente aprobó el libro para imprenta

  provider        String?          // "bubok" | "manual"
  providerOrderId String?
  trackingUrl     String?
  notes           String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

enum PrintOrderStatus {
  PENDING_PAYMENT
  AWAITING_APPROVAL // pagado (pack); se imprime cuando el cliente apruebe el libro
  PAID
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELED
}
