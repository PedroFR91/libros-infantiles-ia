# ============================================
# Libros Infantiles IA - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ── Database ─────────────────────────────────
DATABASE_URL="postgresql://libros_user:CHANGE_ME@db:5432/libros_ia?schema=public"

# ── NextAuth ─────────────────────────────────
NEXTAUTH_URL="https://tudominio.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ── OpenAI ───────────────────────────────────
OPENAI_API_KEY="sk-..."   # ilustraciones (si IMAGE_PROVIDER no es gemini) y moderación

# Claude (Anthropic): con clave, escribe la historia, la revisa, hace el
# control de calidad de cada ilustración y analiza la foto. Sin clave, OpenAI.
ANTHROPIC_API_KEY="sk-ant-..."
CLAUDE_STORY_MODEL="claude-opus-5-5"
CLAUDE_VISION_MODEL="claude-opus-5-5"   # control de calidad y foto
CLAUDE_STORY_EFFORT="low"               # low ~80 s por historia; medium ~3 min

# Ilustraciones con Gemini (Nano Banana) en vez de OpenAI
IMAGE_PROVIDER="gemini"                 # gemini | openai
GEMINI_API_KEY="AQ...."
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"   # o gemini-3-pro-image
GEMINI_IMAGE_SIZE="1K"                  # 1K | 2K (mejor para imprenta)
IMAGE_CONCURRENCY="2"                   # imágenes simultáneas en todo el servidor

# ── Auth Providers (optional) ────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
RESEND_API_KEY=""

# ── Stripe ───────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ── Hetzner Object Storage (S3-compatible) ───
S3_ENDPOINT="https://fsn1.your-objectstorage.com"
S3_BUCKET="libros-ia"
S3_REGION="fsn1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── App ──────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://tudominio.com"
NODE_ENV="production"

# ── Cron (proteger /api/cron/fix-stuck-books; generar con: openssl rand -hex 32) ──
CRON_SECRET="CHANGE_ME"

# ── Datos del titular (aviso legal / privacidad, LSSI art. 10) ──
LEGAL_OWNER_NAME="Nombre y apellidos o razón social"
LEGAL_TAX_ID="NIF"
LEGAL_ADDRESS="Domicilio fiscal completo"

# ── Analítica sin cookies (Umami; vacío = desactivada) ──
ANALYTICS_SCRIPT_SRC="https://cloud.umami.is/script.js"
ANALYTICS_WEBSITE_ID=""

# ── Motor de historias e imágenes ──
STORY_MODEL="gpt-4.1"          # comparar con scripts/eval-engine.ts antes de cambiar
IMAGE_MODEL="gpt-image-1"      # gpt-image-1 | gpt-image-1.5 | gpt-image-1-mini
FREE_PREVIEW_DAILY_LIMIT="60"  # portadas de muestra gratis al día (≈0,40-0,65 $ cada una)

# ── Emails (Resend) ──
EMAIL_FROM="LibrosIA <noreply@libros.iconicospace.com>"
ADMIN_EMAIL="hola@iconicospace.com"   # avisos de pedidos impresos

# ── Libro impreso (Bubok, tapa blanda 21×21; ajustar con su guía de archivos) ──
PRINT_TRIM_MM="210"       # tamaño cuadrado final
PRINT_BLEED_MM="3"
PRINT_SPINE_MM="3"        # según nº de páginas y papel (calculadora de Bubok)
PRINT_COVER_WRAP_MM="0"   # solo tapa dura: envoltura del cartón (~20 mm)
PRINT_MIN_PAGES="32"      # páginas interiores (se completa con páginas en blanco)
# Opcional: super-resolución para imprenta (si no, reescalado local con sharp)
REPLICATE_API_TOKEN=""
REPLICATE_UPSCALE_VERSION=""

# ── Control de calidad por visión (rehace páginas con fallos) ──
QA_ENABLED="true"
QA_MODEL="gpt-4.1-mini"
QA_MAX_RETRIES="2"
