# ============================================
# Libros Infantiles IA - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ── Database ─────────────────────────────────
DATABASE_URL="postgresql://libros_user:CHANGE_ME@db:5432/libros_ia?schema=public"

# ── NextAuth ─────────────────────────────────
NEXTAUTH_URL="https://tudominio.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ── OpenAI ───────────────────────────────────
OPENAI_API_KEY="sk-..."

# ── Auth Providers (optional) ────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
RESEND_API_KEY=""

# ── Stripe ───────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ── Hetzner Object Storage (S3-compatible) ───
S3_ENDPOINT="https://fsn1.your-objectstorage.com"
S3_BUCKET="libros-ia"
S3_REGION="fsn1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── App ──────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://tudominio.com"
NODE_ENV="production"

# ── Cron (proteger /api/cron/fix-stuck-books; generar con: openssl rand -hex 32) ──
CRON_SECRET="CHANGE_ME"

# ── Datos del titular (aviso legal / privacidad, LSSI art. 10) ──
LEGAL_OWNER_NAME="Nombre y apellidos o razón social"
LEGAL_TAX_ID="NIF"
LEGAL_ADDRESS="Domicilio fiscal completo"

# ── Analítica sin cookies (Umami; vacío = desactivada) ──
ANALYTICS_SCRIPT_SRC="https://cloud.umami.is/script.js"
ANALYTICS_WEBSITE_ID=""

# ── Motor de historias e imágenes ──
STORY_MODEL="gpt-4.1"          # comparar con scripts/eval-engine.ts antes de cambiar
IMAGE_MODEL="gpt-image-1"      # gpt-image-1 | gpt-image-1.5 | gpt-image-1-mini
FREE_PREVIEW_DAILY_LIMIT="200" # portadas de muestra gratis al día (≈0,15 € cada una)

# ── Emails (Resend) ──
EMAIL_FROM="LibrosIA <noreply@libros.iconicospace.com>"
ADMIN_EMAIL="hola@iconicospace.com"   # avisos de pedidos impresos

# ── Libro impreso (ajustar a la plantilla del proveedor) ──
PRINT_BLEED_MM="3"        # Gelato: 4
PRINT_SPINE_MM="6"        # según nº de páginas y proveedor
PRINT_COVER_WRAP_MM="0"   # margen de envoltura de tapa dura si lo pide la imprenta
PRINT_MIN_PAGES="30"      # Gelato: 30 · Prodigi: 24
# Opcional: super-resolución para imprenta (si no, reescalado local con sharp)
REPLICATE_API_TOKEN=""
REPLICATE_UPSCALE_VERSION=""
