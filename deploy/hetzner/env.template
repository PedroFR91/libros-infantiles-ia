# /opt/libros/.env — bootstrap.sh genera DB_PASSWORD, NEXTAUTH_SECRET y CRON_SECRET.
# Rellena el resto de CHANGE_ME y ejecuta: docker compose up -d

DB_PASSWORD=__GEN_DB__
NEXTAUTH_SECRET=__GEN_AUTH__
CRON_SECRET=__GEN_CRON__

NEXTAUTH_URL=https://libros.iconicospace.com
AUTH_URL=https://libros.iconicospace.com
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=https://libros.iconicospace.com
NODE_ENV=production

OPENAI_API_KEY=CHANGE_ME

# Redirect URI: https://libros.iconicospace.com/api/auth/callback/google
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

RESEND_API_KEY=CHANGE_ME
EMAIL_FROM="LibrosIA <noreply@iconicospace.com>"

# Claves LIVE (sk_live_/pk_live_). Webhook: https://libros.iconicospace.com/api/stripe/webhook
STRIPE_SECRET_KEY=CHANGE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME

# Opcional: vacío = PDFs e imágenes en volúmenes Docker locales
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Datos del titular (aviso legal / privacidad)
LEGAL_OWNER_NAME=CHANGE_ME
LEGAL_TAX_ID=CHANGE_ME
LEGAL_ADDRESS=CHANGE_ME
# Analítica sin cookies (Umami). Vacío = desactivada
ANALYTICS_SCRIPT_SRC=https://cloud.umami.is/script.js
ANALYTICS_WEBSITE_ID=
# Motor e imágenes
STORY_MODEL=gpt-4.1
IMAGE_MODEL=gpt-image-1
FREE_PREVIEW_DAILY_LIMIT=60
# Emails
EMAIL_FROM=LibrosIA <noreply@libros.iconicospace.com>
ADMIN_EMAIL=hola@iconicospace.com
# Libro impreso (Bubok, tapa blanda 21x21)
PRINT_TRIM_MM=210
PRINT_BLEED_MM=3
PRINT_SPINE_MM=3
PRINT_COVER_WRAP_MM=0
PRINT_MIN_PAGES=32
REPLICATE_API_TOKEN=
REPLICATE_UPSCALE_VERSION=
# Control de calidad por visión
QA_ENABLED=true
QA_MODEL=gpt-4.1-mini
QA_MAX_RETRIES=2
