# /opt/libros/.env — bootstrap.sh genera DB_PASSWORD, NEXTAUTH_SECRET y CRON_SECRET.
# Rellena el resto de CHANGE_ME y ejecuta: docker compose up -d

DB_PASSWORD=__GEN_DB__
NEXTAUTH_SECRET=__GEN_AUTH__
CRON_SECRET=__GEN_CRON__

NEXTAUTH_URL=https://libros.iconicospace.com
AUTH_URL=https://libros.iconicospace.com
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=https://libros.iconicospace.com
NODE_ENV=production

OPENAI_API_KEY=CHANGE_ME

# Redirect URI: https://libros.iconicospace.com/api/auth/callback/google
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

RESEND_API_KEY=CHANGE_ME
EMAIL_FROM="LibrosIA <noreply@iconicospace.com>"

# Claves LIVE (sk_live_/pk_live_). Webhook: https://libros.iconicospace.com/api/stripe/webhook
STRIPE_SECRET_KEY=CHANGE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME

# Opcional: vacío = PDFs e imágenes en volúmenes Docker locales
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
